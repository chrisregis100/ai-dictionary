# Umami Analytics (https://cloud.umami.is)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# URL publique du site (utilisee pour metadataBase, sitemap, canonical, JSON-LD)
# En local, laisser vide : fallback http://localhost:3000
# Sur Vercel, VERCEL_PROJECT_PRODUCTION_URL est utilisee automatiquement si absente
NEXT_PUBLIC_SITE_URL=

# Resend (newsletter) — cote serveur uniquement, ne jamais prefixer NEXT_PUBLIC_
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Neon Postgres (blog) — cote serveur uniquement
DATABASE_URL=

# Neon Auth (Stack) — la cle secrete est cote serveur uniquement
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=
